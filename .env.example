# Copy this file to ".env" and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
# The .env file is gitignored, so your keys never get committed.
# Scripts load it automatically on startup (via env_loader).
# A variable you set in the terminal still overrides the .env value.

# --- Stream discovery + YouTube live-chat scoring ---
# Create a free key: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# --- Twitch live-chat scoring (optional; only if you capture Twitch streams) ---
# TWITCH_CHAT_USERNAME=your_twitch_login
# TWITCH_CHAT_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Publishing through Zernio (only needed for zernio_publish.py / publish.py) ---
# ZERNIO_API_KEY=
# ZERNIO_YOUTUBE_ACCOUNT_ID=
# ZERNIO_INSTAGRAM_ACCOUNT_ID=

# publish.py also accepts these generic aliases instead of the ZERNIO_* names:
# PUBLISH_API_KEY=
# PUBLISH_YOUTUBE_ACCOUNT_ID=
# PUBLISH_INSTAGRAM_ACCOUNT_ID=

# --- Unattended publishing opt-in (leave unset unless you have read the README) ---
# GTA_UNATTENDED_POSTS=1
